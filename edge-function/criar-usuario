import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';

const cors = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
    'Access-Control-Allow-Methods': 'POST, OPTIONS',
};

function json(body: unknown, status = 200) {
    return new Response(JSON.stringify(body), {
        status,
        headers: { ...cors, 'Content-Type': 'application/json' },
    });
}

Deno.serve(async (req) => {
    if (req.method === 'OPTIONS') return new Response('ok', { headers: cors });

    try {
        const URL = Deno.env.get('SUPABASE_URL')!;
        const SERVICE = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;

        // ---- 1. Pega o token cru do header ----
        const authHeader = req.headers.get('Authorization');
        console.log('[DEBUG] authHeader presente:', !!authHeader);

        if (!authHeader || !authHeader.startsWith('Bearer ')) {
            return json({ error: 'Não autenticado (sem token).' }, 401);
        }

        const jwt = authHeader.replace('Bearer ', '').trim();
        console.log('[DEBUG] jwt primeiros 20 chars:', jwt.slice(0, 20));

        // ---- 2. Valida o JWT usando SERVICE_ROLE ----
        // Este é o padrão robusto: o admin client verifica o token
        // do usuário diretamente contra o Auth, sem depender do
        // cliente anon conseguir ler o header.
        const admin = createClient(URL, SERVICE, {
            auth: { autoRefreshToken: false, persistSession: false },
        });

        const { data: userData, error: userErr } = await admin.auth.getUser(jwt);
        console.log('[DEBUG] getUser error:', userErr?.message);
        console.log('[DEBUG] user id:', userData?.user?.id);

        if (userErr || !userData?.user) {
            return json({ error: 'Sessão inválida ou expirada. Faça logout e login novamente.' }, 401);
        }

        const user = userData.user;

        // ---- 3. Confirma que é ADM ativo ----
        // Como já temos o service_role, consultamos direto.
        const { data: perfil, error: perfilErr } = await admin
            .from('usuarios')
            .select('escopo, ativo')
            .eq('id', user.id)
            .maybeSingle();

        console.log('[DEBUG] perfil:', perfil, 'erro:', perfilErr?.message);

        if (perfilErr || !perfil) {
            return json({ error: 'Perfil não encontrado.' }, 403);
        }
        if (!perfil.ativo) {
            return json({ error: 'Usuário inativo.' }, 403);
        }
        if (perfil.escopo !== 'adm') {
            return json({ error: 'Apenas administradores podem criar usuários.' }, 403);
        }

        // ---- 4. Payload ----
        const body = await req.json().catch(() => null);
        if (!body) return json({ error: 'Corpo inválido.' }, 400);

        const nome = String(body.nome || '').trim();
        const email = String(body.email || '').trim().toLowerCase();
        const senha = String(body.senha || '');
        const escopo = String(body.escopo || 'user');
        const ativo = body.ativo !== false;
        const funcaoId = body.funcao_id ? Number(body.funcao_id) : null;

        if (!nome) return json({ error: 'Nome é obrigatório.' }, 400);
        if (!email.includes('@')) return json({ error: 'E-mail inválido.' }, 400);
        if (senha.length < 6) return json({ error: 'A senha deve ter ao menos 6 caracteres.' }, 400);
        if (!['adm', 'user'].includes(escopo)) return json({ error: 'Escopo inválido.' }, 400);

        // ---- 5. Cria no Auth ----
        const { data: created, error: createErr } = await admin.auth.admin.createUser({
            email,
            password: senha,
            email_confirm: true,
            user_metadata: { nome },
        });

        console.log('[DEBUG] createUser error:', createErr?.message);
        console.log('[DEBUG] novo id:', created?.user?.id);

        if (createErr) {
            const m = createErr.message.toLowerCase();
            if (m.includes('already') || m.includes('duplicate') || m.includes('registered')) {
                return json({ error: 'Já existe um usuário com esse e-mail.' }, 400);
            }
            return json({ error: createErr.message }, 400);
        }

        const id = created.user.id;

        // ---- 6. Completa public.usuarios ----
        const { error: upsertErr } = await admin
            .from('usuarios')
            .upsert({ id, nome, email, funcao_id: funcaoId, escopo, ativo }, { onConflict: 'id' });

        if (upsertErr) {
            await admin.auth.admin.deleteUser(id);
            return json({ error: 'Erro ao gravar cadastro: ' + upsertErr.message }, 500);
        }

        return json({ user: { id, nome, email, escopo, ativo } }, 201);

    } catch (e) {
        console.error('[DEBUG] exceção:', e);
        return json({ error: 'Erro inesperado: ' + (e as Error).message }, 500);
    }
});
